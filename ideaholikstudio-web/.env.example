# URL pública definitiva (solo en producción). Sin ella, la web se marca "noindex".
NEXT_PUBLIC_SITE_URL=https://www.ideaholikstudio.com
# "1" solo cuando el dominio real apunte aquí: activa indexación en Google.
SITE_INDEXABLE=0
# Supabase (plan gratis). Sin estas variables la web usa los textos locales.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor: guarda los mensajes del formulario de contacto.
SUPABASE_SERVICE_ROLE_KEY=

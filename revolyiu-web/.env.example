# URL pública de la web (sin barra final)
NEXT_PUBLIC_SITE_URL=https://revolyiu.com
# "production" SOLO cuando el dominio apunte aquí. Cualquier otro valor = noindex.
SITE_ENV=preview
# Supabase (Project Settings → API). La anon key es pública por diseño; RLS protege los datos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
